{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studio-ledger-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
